{{ 'teklo-studio-invitation.css' | asset_url | stylesheet_tag }}
<section class="teklo-studio-invitation" aria-labelledby="StudioInvitation-{{ section.id }}">
  <div class="page-width teklo-studio-invitation__inner">
    <div class="teklo-studio-invitation__copy">
      {% if section.settings.eyebrow != blank %}<p class="teklo-studio-invitation__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 id="StudioInvitation-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    </div>
    {% if section.settings.link != blank and section.settings.link_label != blank %}
      <a class="teklo-studio-invitation__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}<span class="svg-wrapper" aria-hidden="true">{{ 'icon-arrow.svg' | inline_asset_content }}</span></a>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name":"Teklo — Studio invitation",
  "tag":"section",
  "class":"section",
  "disabled_on":{"groups":["header","footer"]},
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The studio"},
    {"type":"text","id":"heading","label":"Heading","default":"An idea. A test. Something made."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>Behind Teklo is a studio built around experimenting, designing, and making. Explore the projects, processes, and work in progress.</p>"},
    {"type":"text","id":"link_label","label":"Link label","default":"Meet the maker"},
    {"type":"url","id":"link","label":"Link"}
  ],
  "presets":[{"name":"Teklo — Studio invitation"}]
}
{% endschema %}