{{ 'section-teklo-process.css' | asset_url | stylesheet_tag }}
{%- style -%}.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top | times: 0.75 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round }}px}@media(min-width:750px){.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}{%- endstyle -%}
<div class="teklo-process color-{{ section.settings.color_scheme }} gradient"><div class="page-width section-{{ section.id }}-padding"><header class="teklo-process__header">{% if section.settings.eyebrow != blank %}<p class="teklo-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="teklo-process__heading inline-richtext">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}</header><ol class="teklo-process__steps">{% for block in section.blocks %}<li class="teklo-process__step" {{ block.shopify_attributes }}><article><div class="teklo-process__media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1600 | image_tag: widths: '375,550,750,990,1200,1600', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy' }}{% elsif block.settings.title == 'FORM' %}<img src="{{ 'placeholder-process-form-cad.png' | asset_url }}" alt="" width="1448" height="1086" loading="lazy">{% elsif block.settings.title == 'MAKE' %}<img src="{{ 'placeholder-process-make-printing.png' | asset_url }}" alt="" width="1448" height="1086" loading="lazy">{% elsif block.settings.title == 'FINISH' %}<img src="{{ 'placeholder-process-finish-assembly.png' | asset_url }}" alt="" width="1536" height="1024" loading="lazy">{% elsif block.settings.title == 'SEND' %}<img src="{{ 'placeholder-process-send-package.png' | asset_url }}" alt="" width="1448" height="1086" loading="lazy">{% else %}<div class="teklo-process__placeholder" role="img" aria-label="Process image not yet supplied"><span>Image pending</span></div>{% endif %}</div><div class="teklo-process__copy"><span aria-hidden="true">{{ block.settings.number | default: forloop.index }}</span><div>{% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}{% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}</div></div></article></li>{% endfor %}</ol>{% if section.settings.button_label != blank %}<a class="button"{% if section.settings.button_link != blank %} href="{{ section.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label | escape }}</a>{% endif %}</div></div>
{% schema %}
{"name":"Teklo — Made at Teklo","tag":"section","class":"section","disabled_on":{"groups":["header","footer"]},"max_blocks":5,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Made at Teklo"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"A considered process"},{"type":"richtext","id":"intro","label":"Introduction"},{"type":"text","id":"button_label","label":"Button label","default":"Our studio"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Top padding","default":96},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Bottom padding","default":96}],"blocks":[{"type":"step","name":"Process step","settings":[{"type":"text","id":"number","label":"Number"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Process step"},{"type":"richtext","id":"text","label":"Description","default":"<p>Describe this stage of the studio process.</p>"}]}],"presets":[{"name":"Teklo — Made at Teklo","blocks":[{"type":"step","settings":{"number":"01"}},{"type":"step","settings":{"number":"02"}},{"type":"step","settings":{"number":"03"}},{"type":"step","settings":{"number":"04"}}]}]}
{% endschema %}
