{{ 'section-teklo-testimonials.css' | asset_url | stylesheet_tag }}
{%- style -%}.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top | times: 0.75 | round }}px;padding-bottom:{{ section.settings.padding_bottom | times: 0.75 | round }}px}@media(min-width:750px){.section-{{ section.id }}-padding{padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px}}{%- endstyle -%}
{%- liquid
  assign has_meaningful_content = false
  if section.settings.rating_text != blank or section.settings.count_text != blank
    assign has_meaningful_content = true
  endif
  for block in section.blocks
    if block.settings.image != blank or block.settings.quote != blank or block.settings.name != blank or block.settings.context != blank
      assign has_meaningful_content = true
      break
    endif
  endfor
-%}
{%- if has_meaningful_content -%}
<div class="teklo-testimonials color-{{ section.settings.color_scheme }} gradient"><div class="page-width section-{{ section.id }}-padding"><header class="teklo-testimonials__header">{% if section.settings.eyebrow != blank %}<p class="teklo-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2 class="teklo-testimonials__heading inline-richtext">{{ section.settings.heading }}</h2>{% endif %}{% if section.settings.rating_text != blank or section.settings.count_text != blank %}<p class="teklo-testimonials__trust">{{ section.settings.rating_text | escape }}{% if section.settings.rating_text != blank and section.settings.count_text != blank %}<span aria-hidden="true"> · </span>{% endif %}{{ section.settings.count_text | escape }}</p>{% endif %}</header><ul class="teklo-testimonials__list" role="list">{% for block in section.blocks %}<li class="teklo-testimonial" {{ block.shopify_attributes }}><figure>{% if block.settings.image != blank %}<div class="teklo-testimonial__media">{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '200,300,400,550,750,1000', sizes: '(min-width: 990px) 30vw, 100vw', loading: 'lazy' }}</div>{% endif %}{% if block.settings.quote != blank %}<blockquote>{{ block.settings.quote }}</blockquote>{% endif %}{% if block.settings.name != blank or block.settings.context != blank %}<figcaption><span>{{ block.settings.name | escape }}</span>{% if block.settings.context != blank %}<span>{{ block.settings.context | escape }}</span>{% endif %}</figcaption>{% endif %}</figure></li>{% endfor %}</ul>{% if section.settings.button_label != blank %}<a class="teklo-text-link"{% if section.settings.button_link != blank %} href="{{ section.settings.button_link }}"{% else %} role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div></div>
{%- endif -%}
{% schema %}
{"name":"Teklo — In their space","tag":"section","class":"section","disabled_on":{"groups":["header","footer"]},"max_blocks":3,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"In their space"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Objects in use"},{"type":"text","id":"rating_text","label":"Verified rating text","info":"Only enter a rating that can be verified."},{"type":"text","id":"count_text","label":"Verified review or order count","info":"Only enter a figure that can be verified."},{"type":"text","id":"button_label","label":"Link label","default":"Read more stories"},{"type":"url","id":"button_link","label":"Link"},{"type":"color_scheme","id":"color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"range","id":"padding_top","min":0,"max":160,"step":4,"unit":"px","label":"Top padding","default":96},{"type":"range","id":"padding_bottom","min":0,"max":160,"step":4,"unit":"px","label":"Bottom padding","default":96}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"image_picker","id":"image","label":"Customer image"},{"type":"richtext","id":"quote","label":"Quote","default":"<p>Share a short customer reflection on living with a Teklo object.</p>"},{"type":"text","id":"name","label":"Name or attribution","default":"Customer name"},{"type":"text","id":"context","label":"Product or context"}]}],"presets":[{"name":"Teklo — In their space","blocks":[{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"}]}]}
{% endschema %}
